#. Error messages - analyse.py (metamodel validation)
msgid "Unknown artifact type: '{atype}'"
msgstr "Неизвестный тип артефакта: '{atype}'"

msgid "Artifact ID '{aid}' does not match schema '{schema}' for type '{atype}'"
msgstr "Идентификатор артефакта '{aid}' не соответствует схеме '{schema}' для типа '{atype}'"

msgid "Attribute '{attr_name}' is not allowed for artifact '{atype}'"
msgstr "Атрибут '{attr_name}' недопустим для артефакта '{atype}'"

msgid "Missing mandatory attribute: '{attr_name}'"
msgstr "Отсутствует обязательный атрибут: '{attr_name}'"

msgid "Attribute '{attr_name}' must be a list (multiple=True)"
msgstr "Атрибут '{attr_name}' должен быть списком (multiple=True)"

msgid "Attribute '{attr_name}' must not be a list (multiple=False)"
msgstr "Атрибут '{attr_name}' не должен быть списком (multiple=False)"

msgid "Attribute '{attr_name}' value '{val}' cannot be converted to an integer"
msgstr "Значение '{val}' атрибута '{attr_name}' не может быть преобразовано в целое число"

msgid "Attribute '{attr_name}' value '{val}' is not a valid boolean ({expected})"
msgstr "Значение '{val}' атрибута '{attr_name}' не является допустимым булевым ({expected})"

msgid "Attribute '{attr_name}' value '{val}' is invalid. Allowed values: {allowed}"
msgstr "Значение '{val}' атрибута '{attr_name}' недопустимо. Допустимые значения: {allowed}"

msgid "Attribute '{attr_name}' value '{val}' is a malformed reference (expected ID string)"
msgstr "Значение '{val}' атрибута '{attr_name}' — некорректная ссылка (ожидается строка ID)"

msgid "Attribute '{attr_name}' value '{val}' refers to an unknown artifact ID '{aid}'"
msgstr "Значение '{val}' атрибута '{attr_name}' ссылается на неизвестный ID артефакта '{aid}'"

msgid "Attribute '{attr_name}' value '{val}' refers to an artifact with unknown type '{atype}'"
msgstr "Значение '{val}' атрибута '{attr_name}' ссылается на артефакт с неизвестным типом '{atype}'"

msgid "Trace from '{from_type}' to '{to_type}' is not allowed"
msgstr "Трассировка от '{from_type}' к '{to_type}' не разрешена"

msgid "Trace from '{from_type}' to '{to_type}' is 'by timestamp', but revision was specified: '{ref}'"
msgstr "Трассировка от '{from_type}' к '{to_type}' задана 'по метке времени', но указана ревизия: '{ref}'"

msgid "Trace from '{from_type}' to '{to_type}' is 'by commit', but no revision was specified for parent '{parent_aid}'"
msgstr "Трассировка от '{from_type}' к '{to_type}' задана 'по коммиту', но не указана ревизия для родителя '{parent_aid}'"

msgid "Missing mandatory trace from '{from_type}' to {targets}"
msgstr "Отсутствует обязательная трассировка от '{from_type}' к {targets}"

msgid "Must have exactly one root artifact"
msgstr "Должен быть ровно один корневой артефакт"

msgid "expected {true_vals} / {false_vals}"
msgstr "ожидается {true_vals} / {false_vals}"

msgid "expected true/false, yes/no, 1/0"
msgstr "ожидается true/false, yes/no, 1/0"


#. Error messages - tree.py
msgid "Conflicting nominal revisions for parent '{parent_id}' in artifact '{artifact_id}': '{existing}' vs '{nominal}'"
msgstr "Конфликт номинальных ревизий для родителя '{parent_id}' в артефакте '{artifact_id}': '{existing}' и '{nominal}'"

msgid "Error processing parent link '{ref}' for artifact '{artifact_id}': {error}"
msgstr "Ошибка обработки родительской связи '{ref}' для артефакта '{artifact_id}': {error}"

msgid "Circular reference detected with {aid}"
msgstr "Обнаружена циклическая ссылка: {aid}"

#. Error messages - extract.py
msgid "Artifact {atype} at {location} has no ID"
msgstr "Артефакт {atype} в {location} не имеет идентификатора"

msgid "Duplicate artifact ID: {aid} at {location} (already defined at {other_location})"
msgstr "Дублирующийся идентификатор артефакта: {aid} в {location} (уже определен в {other_location})"

#. Error messages - metrics.py
msgid "Metrics: No requirements found"
msgstr "Метрики: Требования не найдены"

#. Error messages - artifact.py
msgid "Driver \"{driver}\": {location}: {message}"
msgstr "Драйвер \"{driver}\": {location}: {message}"

msgid "Duplicate AID"
msgstr "Дублирующийся AID"

msgid "Duplicate field \"{field}\""
msgstr "Дублирующееся поле \"{field}\""

msgid "Location is required"
msgstr "Местоположение обязательно"

msgid "AType is required"
msgstr "Тип артефакта обязателен"

msgid "AID is required"
msgstr "Идентификатор артефакта обязателен"


#. Error messages - extractors/markdown.py
msgid "Non-breaking space (NBSP) detected in requirement at line {line} in {file}"
msgstr "Обнаружен неразрывный пробел (NBSP) в требовании на строке {line} в {file}"

msgid "Invalid metadata in YAML at line {line}"
msgstr "Некорректные метаданные YAML на строке {line}"

msgid "Missing ID in metadata at line {line}"
msgstr "Отсутствует ID в метаданных на строке {line}"

msgid "Parse error in requirement at line {line} in {file}"
msgstr "Ошибка разбора требования на строке {line} в {file}"

msgid "Error processing requirement at line {line} in {file}"
msgstr "Ошибка обработки требования на строке {line} в {file}"

msgid "Unclosed YAML block in requirement at line {line} in {file}"
msgstr "Незакрытый блок YAML в требовании на строке {line} в {file}"

msgid "Unterminated requirement at line {line} in {file}"
msgstr "Незавершённое требование на строке {line} в {file}"

#. Error messages - extractors/sidecar.py
msgid "{driver} :: Orphaned sidecar file {path} without matching original file"
msgstr "{driver} :: Файл метаданных {path} без соответствующего основного файла"

msgid "{driver} :: Both .stmx and .syntagmax sidecars are present for {file}"
msgstr "{driver} :: Оба файла .stmx и .syntagmax присутствуют для {file}"

msgid "{driver} :: Missing sidecar file for {file}"
msgstr "{driver} :: Отсутствует файл метаданных для {file}"

msgid "{driver} :: Malformed YAML in sidecar {path}: {error}"
msgstr "{driver} :: Некорректный YAML в файле метаданных {path}: {error}"

msgid "{driver} :: Could not read sidecar {path}: {error}"
msgstr "{driver} :: Не удалось прочитать файл метаданных {path}: {error}"

msgid "{driver} :: Sidecar {path} does not contain a valid YAML dictionary"
msgstr "{driver} :: Файл метаданных {path} не содержит корректного YAML-словаря"

msgid "{driver} :: Missing required 'id' field in sidecar {path}"
msgstr "{driver} :: Отсутствует обязательное поле 'id' в файле метаданных {path}"

msgid "{driver} :: Validation error in {path}: {error}"
msgstr "{driver} :: Ошибка валидации в {path}: {error}"

